[Unit]
Description=stock-asm nightly backups: app data and Contabilidad to the SSD, app data to servercompac, Contpaqi to the HDD
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/backups /srv/backups-contpaqi

[Service]
Type=oneshot
User=agrostma
Group=agrostma
UMask=0027
ExecStart=/srv/agrostma/app/deploy/backup.sh
