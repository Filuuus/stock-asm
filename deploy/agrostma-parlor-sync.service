[Unit]
Description=stock-asm Servicios: add parlors, parts and stall counts from the day's invoices (sync_parlors)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agrostma
Group=agrostma
UMask=0002
WorkingDirectory=/srv/agrostma/app/backend
ExecStart=/srv/agrostma/app/backend/venv/bin/python manage.py sync_parlors --apply
